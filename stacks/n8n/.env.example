# n8n example env
# 실제 값은 .env 파일에 작성하고 커밋하지 마세요.

# n8n 기본 설정
N8N_HOST=n8n.surajung.com
N8N_PORT=5678
N8N_PROTOCOL=https
WEBHOOK_URL=https://n8n.surajung.com/

# 보안 (중요: 기존 n8n-docker/.env 에서 가져오거나 새로 생성)
N8N_ENCRYPTION_KEY=your-encryption-key-here

# Cloudflare Tunnel
CLOUDFLARED_TOKEN=your-cloudflare-tunnel-token-here
